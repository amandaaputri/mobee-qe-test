{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sessionToken": { "type": "string" },
                "user": { "type": "object" }
              },
              "required": ["sessionToken", "user"]
            }
          }
        },
        "required": ["data"]
      }
    }
  },
  "required": ["nodes"]
}
